APP_NAME=HealthTrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# PostgreSQL. Create the database first:
#   createdb healthtrack
# or, from psql:  CREATE DATABASE healthtrack;
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=healthtrack
DB_USERNAME=postgres
DB_PASSWORD=

# --- Health centre ------------------------------------------------------
# Shown in page headers. HealthTrack serves one centre only.
HEALTHTRACK_CENTRE_NAME="Barangay Health Center of Mambog I"
HEALTHTRACK_BARANGAY="Mambog I"
HEALTHTRACK_MUNICIPALITY="Bacoor"
HEALTHTRACK_PROVINCE="Cavite"

# --- Sessions, cache, queue --------------------------------------------
# All database-backed, so there is nothing extra to install.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# --- Mail ---------------------------------------------------------------
# "log" writes emails to storage/logs/laravel.log instead of sending them.
# Password reset and email verification links appear there in development.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@healthtrack.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
